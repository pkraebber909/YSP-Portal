{
  "name": "YSP Portal",
  "image": "mcr.microsoft.com/devcontainers/base:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "bash .devcontainer/start-dev.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "YSP Portal",
      "onAutoForward": "openBrowser"
    }
  }
}
